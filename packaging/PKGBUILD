# Maintainer: NoctaBremen
pkgname=vault-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Explorador de vinilos sobre los dumps de Discogs (Rust + GTK4)"
arch=('x86_64' 'aarch64')
url="https://github.com/NoctaBremen/Atenea"
license=('MIT')
depends=('gtk4' 'mpv' 'yt-dlp')
makedepends=('cargo' 'git')
provides=('vault')
conflicts=('vault')
source=("vault::git+https://github.com/NoctaBremen/Atenea.git")
sha256sums=('SKIP')

pkgver() {
  cd vault
  printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd vault
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd vault
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bins
}

check() {
  cd vault
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --lib
}

package() {
  cd vault
  install -Dm755 target/release/vault "$pkgdir/usr/bin/vault"
  install -Dm755 target/release/vault-importar "$pkgdir/usr/bin/vault-importar"
  install -Dm755 target/release/vault-muestra "$pkgdir/usr/bin/vault-muestra"
  install -Dm755 target/release/vault-catalogo "$pkgdir/usr/bin/vault-catalogo"
  install -Dm644 packaging/io.github.noctabremen.Vault.desktop \
    "$pkgdir/usr/share/applications/io.github.noctabremen.Vault.desktop"
  install -Dm644 packaging/io.github.noctabremen.Vault.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.noctabremen.Vault.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
